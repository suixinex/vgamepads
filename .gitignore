# ============================================================ Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# 虚拟环境（用 uv / venv 创建的都算）
.venv/
venv/
env/
ENV/

# 打包与构建产物
build/
dist/
*.egg-info/
.eggs/

# ============================================================ 运行时生成
# config.ini 由程序首次运行时自动生成，里面存的是每个用户自己的进程列表等配置，
# 属于个人运行状态而不是源码，所以不纳入版本管理。
config.ini

# 日志与临时文件
*.log
*.tmp
*.bak
*~

# ============================================================ 编辑器与系统
.vscode/
.idea/
*.swp
*.swo

# Windows 资源管理器生成的缩略图 / 配置文件
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# ============================================================ 注意
# vgamepad/ 目录是第三方库的副本，必须保留（含 vigem/ViGEmClient.dll），
# 不要把它加进忽略列表。
